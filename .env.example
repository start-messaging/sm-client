# Base URL of the sm-server API (no trailing slash, no /v1 — the client adds it).
VITE_API_BASE_URL=http://localhost:3000

# ── Analytics (optional — omit in local dev; load in staging/prod) ────────────
# PostHog: product events, flags, error tracking.
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://app.posthog.com

# Microsoft Clarity: session recordings / heatmaps (fully free).
# VITE_CLARITY_ID=xxxxxxxxxx

# ── Meta / WhatsApp (optional — only needed for Embedded Signup flow) ──────────
# Your Meta App ID (from developers.facebook.com).
VITE_META_APP_ID=1981218165827222
# Your Embedded Signup config ID (from the app's WhatsApp product settings).
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=1321600123093084
# Graph API version for FB.init — match Embedded Signup Builder (e.g. v26.0).
VITE_META_GRAPH_VERSION=v26.0
# Skip Meta phone add/verify screens (featureType=only_waba_sharing). Use for
# local testing when 555/test numbers block the phone UI. Omit or set false in
# production. Cloud API register still uses our Connect PIN step (register-phone).
# VITE_META_ES_ONLY_WABA_SHARING=true

# Optional: artificial API delay in ms (dev only). Default is 0. Set e.g. 400
# if you want to see loading skeletons against localhost.
# VITE_DEV_API_DELAY_MS=0

# ── HTTPS (Embedded Signup requirement) ────────────────────────────────────────
# `npm run dev` now serves https://localhost:5173 via @vitejs/plugin-basic-ssl.
# On first visit the browser shows a "certificate not trusted" warning — click
# "Advanced → Proceed to localhost" once, and it won't appear again for the session.
#
# Meta App Review / Embedded Signup also require that https://localhost:5173
# is listed in your Meta App's "Allowed Domains" (App Dashboard → Settings →
# Basic → App Domains, and WhatsApp → Configuration → Allowed Origins).
