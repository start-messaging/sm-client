# Base URL of the sm-server API (no trailing slash, no /v1 — the client adds it).
VITE_API_BASE_URL=http://localhost:3000

# ── Analytics (optional — omit in local dev; load in staging/prod) ────────────
# PostHog: product events, flags, error tracking.
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://app.posthog.com

# Microsoft Clarity: session recordings / heatmaps (fully free).
# VITE_CLARITY_ID=xxxxxxxxxx

# ── Meta / WhatsApp (optional — only needed for Embedded Signup flow) ──────────
# Your Meta App ID (from developers.facebook.com).
VITE_META_APP_ID=1981218165827222
# Your Embedded Signup config ID (from the app's WhatsApp product settings).
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=1321600123093084
# Graph API version for FB.init — match Embedded Signup Builder (e.g. v26.0).
VITE_META_GRAPH_VERSION=v26.0

# ── Firebase Cloud Messaging (web push) ───────────────────────────────────────
# Create a Firebase web app + Cloud Messaging. Generate a Web Push certificate
# (VAPID key) under Project settings → Cloud Messaging.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=


